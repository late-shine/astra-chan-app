{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "functions": {
    "api/analyze-kanji.ts": {
      "maxDuration": 40
    },
    "api/synthesize-speech.ts": {
      "maxDuration": 40
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
