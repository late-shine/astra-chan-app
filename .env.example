# Firebase — client-side (VITE_ prefix exposes these to the browser, which is fine for Firebase)
VITE_FIREBASE_API_KEY=your-firebase-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_DATABASE_URL=your-firebase-database-url-here
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

# Google Gemini AI — server-side only (never exposed to browser)
GEMINI_API_KEY=your-gemini-api-key-here

# Kanji drawing checker: optional override of the model fallback chain.
# Comma-separated model ids, first = preferred. Leave commented out to use the
# built-in chain in api/analyze-kanji.ts (DEFAULT_ANALYSIS_MODELS).
# GEMINI_ANALYSIS_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Gemini Text-to-Speech - server-side only (never use a VITE_ prefix)
# Optional: a model to try FIRST. Leave commented out to use the built-in order
# in api/synthesize-speech.ts (3.8 Flash-Lite TTS, 3.8 Flash TTS, 3.1 Flash TTS,
# then 2.5 Flash TTS). Setting this forces that model to be tried before the rest.
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
